# Caminho local para o JSON baixado no Google Cloud. Nunca faça commit do JSON real.
GOOGLE_CLIENT_SECRET_FILE=C:\caminho\para\client_secret.json
# Opcional: evita que o app abra o navegador automaticamente.
OAUTH_OPEN_BROWSER=0

# Exemplos de provedores adicionais. Preencha apenas os que for testar.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_SPOTIFY_CLIENT_ID=
OAUTH_SPOTIFY_CLIENT_SECRET=
